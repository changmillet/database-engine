{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portal.public-flow-link-eligibility.v1.schema.json",
  "title": "Portal exact Flow link eligibility v1",
  "type": "array",
  "maxItems": 50,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "version",
      "linkable"
    ],
    "properties": {
      "id": {
        "$ref": "./portal.common-types.v1.schema.json#/$defs/UUID"
      },
      "version": {
        "$ref": "./portal.common-types.v1.schema.json#/$defs/Version"
      },
      "linkable": {
        "type": "boolean"
      }
    }
  }
}
